# Copy this file to .env for local development.
# Never commit .env or real credentials to source control.

# Application
APP_NAME=ai-video-os-api
APP_ENV=development
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL (local development values only; use managed secrets outside local development)
POSTGRES_DB=ai_video_os
POSTGRES_USER=ai_video_os
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://ai_video_os:change-me-local-only@127.0.0.1:5432/ai_video_os
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_MAX_SECONDS=60

# MinIO / S3-compatible object storage (local development values only)
MINIO_ROOT_USER=<replace-for-local-development>
MINIO_ROOT_PASSWORD=<replace-for-local-development>
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=<same-as-minio-root-user>
STORAGE_SECRET_KEY=<same-as-minio-root-password>
STORAGE_BUCKET=ai-video-os-assets
STORAGE_REGION=us-east-1
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_PRESIGNED_EXPIRY_SECONDS=900
STORAGE_CONNECT_TIMEOUT_SECONDS=3
STORAGE_READ_TIMEOUT_SECONDS=10

# YouTube Publishing (OAuth values must come from a secret manager outside local development)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/publishing/connections/youtube/callback
YOUTUBE_OAUTH_STATE_TTL_SECONDS=600
# Generate outside the repository: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
YOUTUBE_CREDENTIAL_ENCRYPTION_KEY=
