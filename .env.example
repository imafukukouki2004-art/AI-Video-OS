# AI Video OS environment variable template
# Copy this file to .env for local development.
# Never commit .env or real credentials to source control.

# Application
APP_NAME=AI Video OS
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=

# Database
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=ai_video_os
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=

# Redis / asynchronous jobs
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=

# Object storage
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=false

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_VOICE_MODEL=

# Authentication
AUTH_ENABLED=true
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
